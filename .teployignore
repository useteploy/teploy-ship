# What `teploy deploy` skips when syncing this directory to the server
# for the remote image build. The Dockerfile needs only: dist/, web/dist/,
# web/src/ (+ web config files), and deploy/ (vendor tarballs + runtime
# package.jsons).
.git
node_modules
reference
evals
swebench
_internal
/src
/web/dist/**/*.map
# install.sh's secret bundle. It holds REAL values; the server already has
# them, age-encrypted, and a plaintext copy has no business riding along in a
# build context.
ship-secrets.env
*.secrets.env
