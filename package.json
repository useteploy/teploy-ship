{
  "name": "teploy-ship",
  "version": "0.0.1",
  "private": true,
  "description": "Teploy Ship \u2014 Teploy's coding agent: a CodeAct brain on the Neutron primitives. Issues in, PRs out, self-hosted.",
  "author": "Tyler",
  "license": "MIT",
  "type": "module",
  "bin": {
    "teploy-ship": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "import": "./dist/plan.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit --pretty false",
    "test": "pnpm run build && node --test --experimental-test-isolation=none \"dist/**/*.test.js\"",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@neutron-build/agents": "^0.1.0",
    "@neutron-build/ai": "^0.1.0",
    "@neutron-build/workflow": "^0.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.0",
    "dockerode": "^5.0.1",
    "tar-stream": "^3.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
